---
import BlogListItem from "./BlogListItem.astro";
const allPosts = Object.values(import.meta.glob('../pages/posts/*.md', { eager: true }));
---

<style>
	ol {
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
 
	li + li {
		margin-top: 3rem;
	}
</style>

<ol>
	{allPosts.toSorted((a, b) => b.frontmatter.published.localeCompare(a.frontmatter.published)).map((post) => <li><BlogListItem post={post} /></li>)}
</ol>
