---
import HeartLogo from '../assets/heart-logo.inline.svg';
---

<style>
  h2 {
    color: var(--color-secondary);
    font-family: var(--family-heading);
    font-size: 2.2rem;
    font-weight: 400;
    text-transform: lowercase;
    margin: 0 0 1rem;
    line-height: 1;
  }

  nav {
    display: flex;
    gap: 2rem;
  }

  li {
    list-style-type: none;
    
    &:not(:first-child)::before {
      content: '';
      display: inline-block;
      height: 20px;
      width: 2px;
      background-color: var(--color-lightest);
      position: relative;
      left: -1rem;
      top: 3px;
    }
  }

  a {
    text-transform: lowercase;
  }
</style>

<div class="aside">
  <h2>Hello!</h2>
  <p>I'm Mark Goetz, a front-end developer in Philadelphia.  I've been designing and coding web interfaces for 15 years.</p>
  
  <h2>Designy outside,<br/>mathy inside</h2>
  <p>I combine technical knowledge with design sense and empathy to make excellent web experiences.</p>

  <nav>
    <li><a href="mailto:mark@markgoetz.dev">Email</a></li>
    <li><a href="">Github</a></li>
    <li><a href="">LinkedIn</a></li>
  </nav>
  <HeartLogo />
</div>