---
import Aside from "../components/Aside.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<div class="container">
  <header>
		<Header />
	</header>
  <main>
    <slot />
  </main>
  <aside>
    <Aside />
  </aside>
  <footer>
    <Footer />
  </footer>
</div>

<style>
  .container {
    margin: auto;
    display: grid;
    grid-template-areas: 
      "header aside"
      "main   aside"
      "footer footer";
    max-width: 65rem;
    gap: 4rem;
    grid-template-columns: auto 22rem;
    grid-template-rows: auto 1fr auto;
  }

  header {
    grid-area: header;
  }

  main {
    grid-area: main;
  }

  aside {
    grid-area: aside;
  }

  footer {
    grid-area: footer;
  }
</style>