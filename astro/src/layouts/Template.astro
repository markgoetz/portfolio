---
import SiteContainer from './SiteContainer.astro';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/heart.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Mark Goetz</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,200..800;1,200..800&family=Zilla+Slab:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
	</head>
	<body>
		<SiteContainer><slot /></SiteContainer>
	</body>
</html>

<style>
	:root {
		--family-body: 'Atkinson Hyperlegible Next', sans-serif;
		--family-heading: 'Zilla Slab', monospace;
		--color-primary: #B3043B;
		--color-secondary: #0B73B8;
		--color-secondary-light: #f6fcff;
		--color-tertiary: #6C7075;
		--color-lightest: #bebfc1;
		--color-body: #302327;
	}

	html,
	body {
		margin: 0;
		padding: 1rem;
		width: 100%;
		height: 100%;
		font-family: var(--family-body);
		color: var(--color-body);
		background-color: var(--color-secondary-light);
		outline-color: var(--color-secondary);
	}

</style>
